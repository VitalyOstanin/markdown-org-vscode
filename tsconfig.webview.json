{
  // The agenda webview client is a separate TypeScript project because it
  // targets the browser: it needs `lib: dom`, which the extension host code
  // must NOT have (the host runs in Node, and DOM globals there would type-check
  // into a runtime failure). Referenced from tsconfig.json, so `tsc -b` builds
  // this first and the host resolves `../webview/agendaClient` through the
  // emitted declaration file rather than compiling the source a second time.
  //
  // The client stays self-contained -- no runtime imports at all -- because its
  // body is inlined into the page via `Function.prototype.toString()`, which
  // does not carry module bindings. Everything it needs arrives through its
  // parameters; only the *types* of those parameters are imported.
  //
  // Those type-only sources (the extractor payload contract and the UI string
  // dictionary) are therefore part of this project rather than the host one:
  // a file belongs to exactly one project, and the host reads them back through
  // the declarations emitted here. Neither uses a DOM global, so building them
  // with `lib: dom` present changes nothing about them.
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2024",
    "outDir": "out",
    "rootDir": "src",
    "lib": ["ES2024", "DOM"],
    "types": [],
    "sourceMap": true,
    "strict": true,
    // Same as the host project: an optional property is absent or holds a
    // value, never an explicit undefined, and indexing yields `T | undefined`.
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "out/.tsbuildinfo-webview"
  },
  "include": ["src/webview/**/*", "src/types.ts", "src/utils/agendaI18n.ts"]
}
