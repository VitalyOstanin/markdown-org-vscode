{
  // The task `launch.json` runs before starting the Extension Development
  // Host. `tsc -b` builds the extension and the webview client together; a
  // plain `tsc -p .` would leave the client's output behind.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: compile"
    }
  ]
}
