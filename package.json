{
  "name": "markdown-org-vscode",
  "displayName": "Markdown Org",
  "description": "Org-mode style task management in Markdown: TODO/DONE workflow, priorities, SCHEDULED/DEADLINE timestamps, agenda views, and CLOCK time tracking.",
  "version": "0.11.1",
  "publisher": "vitalyostanin",
  "repository": {
    "type": "git",
    "url": "https://github.com/VitalyOstanin/markdown-org-vscode"
  },
  "homepage": "https://github.com/VitalyOstanin/markdown-org-vscode#readme",
  "bugs": {
    "url": "https://github.com/VitalyOstanin/markdown-org-vscode/issues"
  },
  "qna": false,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#272822",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "agenda",
    "clock",
    "clocktable",
    "deadline",
    "gtd",
    "markdown",
    "org",
    "org-mode",
    "planning",
    "productivity",
    "scheduled",
    "task management",
    "tasks",
    "time tracking",
    "todo"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, configured executable paths (e.g. markdown-org.extractorPath) and file paths (markdown-org.maintainFilePath, markdown-org.workspaceDir) are not used.",
      "restrictedConfigurations": [
        "markdown-org.extractorPath",
        "markdown-org.maintainFilePath",
        "markdown-org.workspaceDir"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdown-org.setTodo",
        "title": "Set TODO",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.setDone",
        "title": "Set DONE",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.setCancelled",
        "title": "Set CANCELLED",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.togglePriority",
        "title": "Toggle Priority",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertCreated",
        "title": "Insert CREATED Timestamp",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertScheduled",
        "title": "Insert SCHEDULED Timestamp",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertDeadline",
        "title": "Insert DEADLINE Timestamp",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertClockStart",
        "title": "Insert CLOCK Start",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertClockFinish",
        "title": "Insert CLOCK Finish",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.insertClockTable",
        "title": "Insert CLOCK Table",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.showAgendaDay",
        "title": "Show Agenda (Day)",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.showAgendaWeek",
        "title": "Show Agenda (Week)",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.showAgendaMonth",
        "title": "Show Agenda (Month)",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.showTasks",
        "title": "Show Tasks",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.agendaBack",
        "title": "Go Back in Agenda",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.agendaForward",
        "title": "Go Forward in Agenda",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.timestampUp",
        "title": "Timestamp Up",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.timestampDown",
        "title": "Timestamp Down",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.toggleTimestampActive",
        "title": "Toggle Timestamp Active/Inactive",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.moveToArchive",
        "title": "Move to Archive",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.promoteToMaintain",
        "title": "Promote to Maintain",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.cycleTag",
        "title": "Cycle Tag Filter",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.cycleAgendaHeaderMode",
        "title": "Cycle Agenda Header Layout",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.gcalSync.connect",
        "title": "Connect Google Calendar",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.gcalSync.disconnect",
        "title": "Disconnect Google Calendar",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.gcalSync.selectCalendar",
        "title": "Select Google Calendar",
        "category": "Markdown Org"
      },
      {
        "command": "markdown-org.gcalSync.syncNow",
        "title": "Sync Now (Google Calendar)",
        "category": "Markdown Org"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdown-org.agendaBack",
          "when": "markdown-org.agendaFocused"
        },
        {
          "command": "markdown-org.agendaForward",
          "when": "markdown-org.agendaFocused"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdown-org.setTodo",
        "key": "ctrl+k ctrl+t",
        "mac": "cmd+k cmd+t",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.setDone",
        "key": "ctrl+k ctrl+d",
        "mac": "cmd+k cmd+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.setCancelled",
        "key": "ctrl+k ctrl+x",
        "mac": "cmd+k cmd+x",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.togglePriority",
        "key": "ctrl+k ctrl+p",
        "mac": "cmd+k cmd+p",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertCreated",
        "key": "ctrl+k ctrl+k ctrl+c",
        "mac": "cmd+k cmd+k cmd+c",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertScheduled",
        "key": "ctrl+k ctrl+k ctrl+s",
        "mac": "cmd+k cmd+k cmd+s",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertDeadline",
        "key": "ctrl+k ctrl+k ctrl+d",
        "mac": "cmd+k cmd+k cmd+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertClockStart",
        "key": "ctrl+k ctrl+c ctrl+s",
        "mac": "cmd+k cmd+c cmd+s",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertClockFinish",
        "key": "ctrl+k ctrl+c ctrl+f",
        "mac": "cmd+k cmd+c cmd+f",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.insertClockTable",
        "key": "ctrl+k ctrl+c ctrl+v",
        "mac": "cmd+k cmd+c cmd+v",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.showAgendaDay",
        "key": "ctrl+k ctrl+k ctrl+y",
        "mac": "cmd+k cmd+k cmd+y",
        "when": "(editorTextFocus && editorLangId == markdown) || markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.showAgendaWeek",
        "key": "ctrl+k ctrl+w",
        "mac": "cmd+k cmd+w",
        "when": "(editorTextFocus && editorLangId == markdown) || markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.showAgendaMonth",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "(editorTextFocus && editorLangId == markdown) || markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.showTasks",
        "key": "ctrl+k ctrl+k ctrl+l",
        "mac": "cmd+k cmd+k cmd+l",
        "when": "(editorTextFocus && editorLangId == markdown) || markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.agendaBack",
        "key": "alt+shift+-",
        "when": "markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.agendaForward",
        "key": "alt+shift+=",
        "when": "markdown-org.agendaFocused"
      },
      {
        "command": "markdown-org.timestampUp",
        "key": "shift+up",
        "when": "editorTextFocus && editorLangId == markdown && markdown-org.timestampAdjustable"
      },
      {
        "command": "markdown-org.timestampDown",
        "key": "shift+down",
        "when": "editorTextFocus && editorLangId == markdown && markdown-org.timestampAdjustable"
      },
      {
        "command": "markdown-org.moveToArchive",
        "key": "ctrl+k ctrl+k ctrl+m ctrl+a",
        "mac": "cmd+k cmd+k cmd+m cmd+a",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.promoteToMaintain",
        "key": "ctrl+k ctrl+k ctrl+m ctrl+p",
        "mac": "cmd+k cmd+k cmd+m cmd+p",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdown-org.cycleTag",
        "key": "ctrl+k ctrl+k ctrl+t",
        "mac": "cmd+k cmd+k cmd+t",
        "when": "(editorTextFocus && editorLangId == markdown) || markdown-org.agendaFocused"
      }
    ],
    "configuration": {
      "title": "Markdown Org",
      "properties": {
        "markdown-org.extractorPath": {
          "type": "string",
          "default": "",
          "description": "Path to markdown-org-extract executable. Empty (default) uses the bundled binary, falling back to PATH. Set to override (e.g. an absolute path for local builds)."
        },
        "markdown-org.workspaceDir": {
          "type": "string",
          "default": "",
          "description": "Directory to scan for markdown files (empty = workspace root)"
        },
        "markdown-org.maintainFilePath": {
          "type": "string",
          "default": "",
          "description": "Path to maintain file for promoted headings (empty = disabled)"
        },
        "markdown-org.dateLocale": {
          "type": "string",
          "default": "en-US",
          "description": "Locale for date formatting (e.g., en-US, ru-RU, de-DE)"
        },
        "markdown-org.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "Follow markdown-org.dateLocale if you set it, then the VS Code display language, then English",
            "English",
            "Russian"
          ],
          "default": "auto",
          "description": "Language of the agenda interface (buttons, section titles, tooltips). Notification messages, command names and these setting descriptions stay in English."
        },
        "markdown-org.firstDayOfWeek": {
          "type": "string",
          "enum": [
            "monday",
            "sunday",
            "auto"
          ],
          "default": "monday",
          "description": "First day of week in month calendar. 'auto' uses locale's default via Intl.Locale.weekInfo (falls back to monday if unsupported)."
        },
        "markdown-org.fileTags": {
          "type": "array",
          "default": [
            {
              "name": "ALL",
              "pattern": ""
            },
            {
              "name": "WORK",
              "pattern": "work"
            },
            {
              "name": "PRIVATE",
              "pattern": "!work"
            }
          ],
          "description": "File tags. Pattern is matched (substring) against the file's basename. Empty pattern disables the filter (show all). '!'-prefix means 'not matching any positive pattern' — the text after '!' is ignored."
        },
        "markdown-org.currentTag": {
          "type": "string",
          "default": "ALL",
          "description": "Currently selected tag filter for agenda view. Stored per workspace when a workspace is open."
        },
        "markdown-org.agendaFontFamily": {
          "type": "string",
          "default": "",
          "description": "Proportional font family for the agenda view, as a CSS font stack. Empty means 'Adwaita Sans', 'Noto Sans', system-ui, sans-serif. A value that is not a plain font stack is ignored and the default is used."
        },
        "markdown-org.agendaHeaderMode": {
          "type": "string",
          "enum": [
            "auto",
            "full",
            "compact"
          ],
          "enumDescriptions": [
            "Compact on a short panel, full otherwise.",
            "Always the full header: the date title on its own line above the controls.",
            "Always compact: the date title sits on the control row, with tighter type and spacing."
          ],
          "default": "auto",
          "description": "Agenda header layout. The full header takes about a fifth of a short panel, leaving little room for the tasks; the compact one puts the date title on the control row."
        },
        "markdown-org.clockRoundMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 60,
          "description": "Round CLOCK timestamps to N minutes (e.g., 15, 30). 0 disables rounding. Negative and out-of-range values are also treated as 'no rounding'."
        },
        "markdown-org.weekdayLocale": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "default": "ru",
          "description": "Language for the weekday short name inserted into timestamps (CREATED/SCHEDULED/DEADLINE/CLOCK). 'ru' produces Пн/Вт/..., 'en' produces Mon/Tue/...."
        },
        "markdown-org.gcalSync.clientId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Google OAuth Desktop client_id for Calendar sync (BYO). The client_secret is entered on connect and stored in the OS keychain, not here."
        },
        "markdown-org.gcalSync.calendarName": {
          "type": "string",
          "default": "markdown-org",
          "description": "Name used to find-or-create the sync calendar when no calendarId is pinned."
        },
        "markdown-org.gcalSync.calendarId": {
          "type": "string",
          "default": "",
          "description": "Pinned Google calendar id for sync (takes precedence over calendarName). Usually set by the Select Google Calendar command."
        },
        "markdown-org.gcalSync.concurrencyPolicy": {
          "type": "string",
          "enum": [
            "queue",
            "cancel"
          ],
          "default": "queue",
          "description": "Behaviour when a sync is requested while one is running (within a window): 'queue' coalesces into a single rerun; 'cancel' aborts the current run and restarts."
        },
        "markdown-org.gcalSync.syncOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run a Google Calendar sync (debounced) after saving a markdown file."
        },
        "markdown-org.gcalSync.syncOnSaveDebounceMs": {
          "type": "number",
          "default": 5000,
          "description": "Debounce interval (ms) for the sync-on-save trigger."
        },
        "markdown-org.gcalSync.onDone": {
          "type": "string",
          "enum": [
            "delete",
            "keep"
          ],
          "default": "delete",
          "description": "When a task becomes DONE: 'delete' removes its calendar event; 'keep' leaves it."
        },
        "markdown-org.gcalSync.defaultEventMinutes": {
          "type": "number",
          "default": 60,
          "description": "Duration for a timed task event when no end time is given."
        },
        "markdown-org.gcalSync.authProvider": {
          "type": "string",
          "enum": [
            "auto",
            "goa",
            "oauth"
          ],
          "default": "auto",
          "description": "Source of the Google OAuth access token. 'oauth': BYO Desktop client (loopback + PKCE, stored in the OS keychain). 'goa': on Linux, take the token from GNOME Online Accounts (no per-user OAuth setup, GOA refreshes it). 'auto' (default): use GOA on Linux when a Google account is present there, otherwise BYO OAuth."
        },
        "markdown-org.gcalSync.goaAccount": {
          "type": "string",
          "default": "",
          "description": "Email of the GNOME Online Accounts Google account to use when authProvider resolves to 'goa'. Empty: auto-pick when exactly one Google account exists, otherwise chosen via the Connect command."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "watch": "tsc -b --watch",
    "test": "npm run compile && mocha --config .mocharc.unit.json",
    "test:watch": "npm run compile && node ./scripts/test-watch.js",
    "test:coverage": "npm run compile && c8 mocha --config .mocharc.unit.json",
    "test:integration": "npm run compile && node ./scripts/run-integration-tests.js",
    "test:integration:coverage": "npm run compile && node ./scripts/run-integration-tests.js --coverage --coverage-output=./coverage/integration",
    "coverage:check:integration": "node ./scripts/check-lcov-thresholds.js ./coverage/integration/lcov.info --lines=78 --functions=68 --branches=73",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package",
    "prepare": "husky"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5",
    "qs": "^6.15.2",
    "brace-expansion": "^5.0.8"
  },
  "x-markdown-org": {
    "extractorVersion": "0.11.1",
    "extractorSha256": {
      "x86_64-unknown-linux-gnu": "5095947c9bf2529f38661e9c947a0337e2d6117d025206bea8196896b746e305",
      "x86_64-apple-darwin": "49996beef9b3f5e832c10fc99792080250325ce30f4ac41ec46d2fa28da82a6d",
      "aarch64-apple-darwin": "2f952f53b9b8c45b10098b2aba84637f3d51be5a04bcd29411dab9e455bd2deb",
      "x86_64-pc-windows-msvc": "cdb67cc3d4a13600d56585d63ae0ff944da497b199c50b236ccd42cfccda35a7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
